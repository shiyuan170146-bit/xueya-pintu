 "intro": {
  "POL": {
   "simple": "6 门思政课，全部必修、学分固定，没有选择空间。",
   "when": "按第 1→4 学期顺序开，第 4 学期一次上 2 门。",
   "tips": [
    "「形势与政策（二）」1 学分不在这里，算在实践教学环节，别重复算进这 16 学分。"
   ]
  },
  "PUB": {
   "simple": "外语 8 + 数学 14 + 信息科技 2 + 军事理论 2，四块拼起来 26 学分。",
   "when": "外语限第 1–4 学期内修完；军事理论在第 1 学期；数学集中在前 4 学期。",
   "tips": [
    "外语每学期只开约 2 学分，一旦断档后面很难补齐，务必连修 4 学期。"
   ]
  },
  "PEAL": {
   "simple": "体育 4 + 美育 2，另外劳育 0 学分但要修满 32 学时。",
   "when": "一、二年级每学期体育 1 学分；美育毕业前修完即可；劳育依托第 6 学期《数字乡村劳动实习》。",
   "tips": [
    "游泳考核必须在大一完成（大一上或大一下均可），拖不到后面。",
    "每年体测必须达标，否则影响毕业。",
    "劳育不单独计学分，但没完成一样毕不了业。",
    "美育课可以选 MOOC，但美育和通识共享额度：合计最多 2 次 MOOC、最多计 2 学分。"
   ]
  },
  "GE": {
   "simple": "四门指定选修（写作与沟通、大学生创新创业基础、大学生心理发展与指导、大学生心理素质拓展）+ 其余任选，合计 ≥9 学分。",
   "when": "三门指定课要求在第 1–2 学期修完；其余任选不限学期。",
   "tips": [
    "指定课没有替代品，前两年就该修掉，拖到后面开课冲突很难补。",
    "通识任选可以用 MOOC 凑，但通识 MOOC 最多计 2 学分，原则上一共只能选 2 次。",
    "美育课也有 MOOC 形式，但美育和通识共享同一个额度：两边加起来一共只能选 2 次 MOOC、最多计 2 学分。"
   ]
  },
  "MAJOR": {
   "simple": "平台课 23 + 专业核心 12 + 开放性专业选修 ≥27 + 国际课程 ≥2，是 151 学分里最大的一块。",
   "when": "平台课与核心课主要在第 3–6 学期；开放选修分散在各学期，第 5、6 学期最集中。",
   "tips": [
    "开放选修里必须含至少 4 学分的「交叉类课程」，不是随便凑够 27 学分就行。",
    "课表里带「＋」的理论课与实验课必须同时选，漏选一个另一个也失效。",
    "国际课程 ≥2 学分，可用国际课程 / 暑期课程 / 国外游学 / 国际竞赛等认定。",
    "指导性计划里开放选修排了约 35 学分，而要求只要 27，多出来的是「选够即可」的余量。"
   ]
  },
  "PRAC": {
   "simple": "公共实践 7 + 专业实践 16 + 指定选修 2 + 配套实验 5，共 30 学分。",
   "when": "教学实习在第三年暑假，毕业实习在第四年，毕业论文在第 7–8 学期——都是按时间段开放的。",
   "tips": [
    "这些实践环节错过时间窗就要等一整年，是「大四突然差一堆学分」的最常见原因。"
   ]
  }
 },
 "pitfalls": [
  {
   "level": "high",
   "title": "交叉类课程 ≥4 学分最容易漏",
   "text": "开放性专业选修不是凑够 27 学分就完事——其中至少 4 学分必须是全校范围的交叉类课程。"
  },
  {
   "level": "high",
   "title": "带「＋」的课必须成对选",
   "text": "理论课与配套实验课要求同时修读，第 6 学期集中出现（企业运营管理模拟＋实验、数字工程原理和方法＋实验等）。漏选实验，理论课也一起失效。"
  },
  {
   "level": "mid",
   "title": "数字乡村劳动实习不单独计学分",
   "text": "修读计划里注明「不单独计学分」，别把它当成 2 个毕业学分来算，但劳动学时要求必须完成。"
  },
  {
   "level": "low",
   "title": "版本口径",
   "text": "本站内置的是 2023 版培养方案。若你所在年级另有专属方案，一切以教务认定为准。"
  }
